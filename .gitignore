node_modules/
*.log
.DS_Store

# pnpm's local content-addressable store, if a package ever sets store-dir.
# A build cache, never source.
.pnpm-store/

# Plugin runtime state. dsh-todo writes one SQLite database per workspace at
# <workspace>/.dsh/todo.db; when a package folder is itself opened as a
# workspace, that lands here. It is user data, not source.
.dsh/

# Intermediate esbuild output. lib/index.js and lib/client.js are the real
# artifacts; this is the pre-wrap CJS body that build/build.mjs wraps in the
# host loader's closure-factory convention.
**/lib/client.body.cjs

# NOTE: every package commits its built lib/ on purpose. These plugins are
# installed straight from GitHub subdirectories
# (pnpm add "github:owner/repo#path:/plugins/<name>"), and a git install runs no
# build step — an uncommitted lib/ means the package arrives with no output and
# fails to load. Rebuild and commit lib/ when you change src/.
