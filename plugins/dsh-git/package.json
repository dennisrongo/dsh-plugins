{
  "name": "@dennisrongo/dsh-git",
  "version": "0.4.0",
  "description": "Git source-control tab for DeepSeek Harness (dsh) — changes, history, branches, merge, stash and worktrees for a workspace's repository",
  "type": "module",
  "license": "MIT",
  "author": "Dennis Rongo",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client.body.cjs",
    "!lib/*.test.mjs",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build/build.mjs && node --experimental-strip-types test/smoke.mjs && node --experimental-strip-types test/host-ops.mjs && node --experimental-strip-types test/env-isolation.mjs && node --experimental-strip-types test/branch-ops.mjs && node test/worktree-integration.mjs && node --experimental-strip-types test/watch-probe.mjs",
    "test:ui": "node test/verify-ui.mjs",
    "test:ai": "node test/verify-ai.mjs",
    "test:commit": "node test/verify-commit.mjs",
    "test:layout": "node test/layout-probe.mjs",
    "test:stability": "node test/list-stability-probe.mjs",
    "test:skeleton": "node test/skeleton-probe.mjs",
    "test:icons": "node test/icon-probe.mjs",
    "test:history": "node test/history-probe.mjs",
    "test:menu": "node test/menu-probe.mjs",
    "test:watch": "node --experimental-strip-types test/watch-probe.mjs",
    "test:env": "node --experimental-strip-types test/env-isolation.mjs",
    "test:branch": "node --experimental-strip-types test/branch-ops.mjs",
    "test:worktree": "node test/worktree-integration.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisrongo/dsh-plugins.git",
    "directory": "plugins/dsh-git"
  },
  "homepage": "https://github.com/dennisrongo/dsh-plugins/tree/main/plugins/dsh-git#readme",
  "bugs": {
    "url": "https://github.com/dennisrongo/dsh-plugins/issues"
  }
}
