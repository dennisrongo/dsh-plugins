{
  "name": "@dennisrongo/dsh-todo",
  "version": "0.4.1",
  "description": "Todo list for DeepSeek Harness (dsh) — a per-workspace task list persisted on disk by the host",
  "type": "module",
  "license": "MIT",
  "author": "Dennis Rongo",
  "main": "lib/index.js",
  "bin": {
    "dsh-todo": "lib/bin.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./cli": {
      "default": "./lib/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client.body.cjs",
    "!lib/*.test.mjs",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build/build.mjs && node test/smoke.mjs && node test/context-probe.mjs && node test/launch-effect.mjs && node test/launch-lifecycle.mjs && node test/cli.test.mjs && node test/cli-integration.mjs",
    "test:icons": "node test/icon-probe.mjs",
    "test:modal": "node test/modal-probe.mjs",
    "test:cli": "node test/cli.test.mjs",
    "test:integration": "node test/cli-integration.mjs",
    "test:agent": "node test/verify-agent.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisrongo/dsh-plugins.git",
    "directory": "plugins/dsh-todo"
  },
  "homepage": "https://github.com/dennisrongo/dsh-plugins/tree/main/plugins/dsh-todo#readme",
  "bugs": {
    "url": "https://github.com/dennisrongo/dsh-plugins/issues"
  }
}
