{
  "name": "@dennisrongo/dsh-mission-control",
  "version": "0.3.0",
  "description": "Mission Control dashboard for DeepSeek Harness (dsh) — live session fleet, swarm tree, token burn, and permission inbox as a shell.overlay plugin",
  "type": "module",
  "license": "MIT",
  "author": "Dennis Rongo",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client.body.cjs",
    "!lib/*.test.mjs",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisrongo/dsh-plugins.git",
    "directory": "plugins/dsh-mission-control"
  },
  "homepage": "https://github.com/dennisrongo/dsh-plugins/tree/main/plugins/dsh-mission-control#readme",
  "bugs": {
    "url": "https://github.com/dennisrongo/dsh-plugins/issues"
  }
}
