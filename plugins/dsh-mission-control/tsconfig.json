{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    // The Typert @Remote decorator is a TC39 STANDARD decorator, not a legacy
    // TypeScript one. This must stay false or the marker never registers.
    "experimentalDecorators": false,
    "types": ["react", "node"],
    "baseUrl": ".",
    "paths": {
      // Typecheck against the RUNNING dsh install (anchored by
      // scripts/anchor.mjs), which is what the peers resolve to at runtime.
      "@deepseek-ai/dsh-client-runtime": [
        "./node_modules/@deepseek-ai/dsh-client-runtime/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-runtime/client": [
        "./node_modules/@deepseek-ai/dsh-client-runtime/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/cordis": [
        "./node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-typert-protocol": [
        "./node_modules/@deepseek-ai/dsh-typert-protocol/lib/types/index.d.ts"
      ]
    }
  },
  "include": ["src"]
}
