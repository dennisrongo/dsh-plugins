{
  // Declaration emit for the HOST half only.
  //
  // package.json's `.` export promises `lib/types/index.d.ts`; nothing emitted
  // it, so a TypeScript consumer importing this package resolved types to a
  // file that did not exist. The base config is `noEmit` and spans all of src
  // (including the 6k-line client half, whose types are not part of the `.`
  // export), so declarations get their own narrow config here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib/types",
    "rootDir": "src"
  },
  "include": ["src/index.ts"]
}
